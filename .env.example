DATABASE_URL="postgresql://user:password@localhost:5432/wealthx?schema=public"

# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-secret"

# "mock" (default) logs OTPs to the server console instead of sending SMS.
# See lib/auth/otp-provider.ts to plug in a real provider (MSG91, Twilio, etc).
OTP_PROVIDER="mock"
OTP_TTL_SECONDS="300"

# Live CMP updates. "yahoo" (default) needs no key. See lib/market/.
MARKET_DATA_PROVIDER="yahoo"

# Generate with: openssl rand -hex 24
MARKET_REFRESH_SECRET="replace-with-a-long-random-secret"

# /admin login — separate from customer accounts. Generate with:
#   npm run admin:hash-password -- "your-new-password"
# and paste the printed line as-is — it comes pre-escaped for Next's env
# loader, which otherwise interpolates the "$" in a raw bcrypt hash away.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="replace-with-a-bcrypt-hash"
